<mujoco model="ur5e_workcell">
  <include file="ur5e.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3"/>
  </visual>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.8 0.8 0.8 1"
          friction="1 0.005 0.0001"/>

    <!-- Table: 0.5 x 0.8 x 0.4 m, center (0.55, 0, 0.2), top at z = 0.4 -->
    <geom name="table" type="box" size="0.25 0.4 0.2" pos="0.55 0 0.2"
          rgba="0.6 0.5 0.4 1" friction="0.5 0.005 0.0001"/>

    <!-- Cube: 0.04 m, 0.2 kg, friction 0.5 -->
    <body name="cube" pos="0.5 -0.2 0.42">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.02 0.02 0.02" mass="0.2"
            friction="0.5 0.005 0.0001" rgba="0.9 0.1 0.1 1"/>
    </body>

    <!-- Target marker: visual only, no collision -->
    <geom name="target" type="box" size="0.03 0.03 0.001" pos="0.5 0.2 0.401"
          contype="0" conaffinity="0" rgba="0.1 0.8 0.1 1"/>
  </worldbody>
  <actuator>
    <motor name="finger_r" joint="finger_r_joint" ctrlrange="-8 8"/>
    <motor name="finger_l" joint="finger_l_joint" ctrlrange="-8 8"/>
  </actuator>
</mujoco>
