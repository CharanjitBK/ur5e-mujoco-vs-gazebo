<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="ur5e_experiment">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>100</update_rate>
    </plugin>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
    <ode><solver><type>quick</type><iters>150</iters></solver></ode></physics>

    <model name="table">
      <static>true</static>
      <pose>0.55 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.8 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.8 0.4</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient></material></visual>
      </link>
    </model>

    <model name="cube">
      <pose>0.5 -0.2 0.42 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.2</mass>
          <inertia><ixx>5.33e-5</ixx><iyy>5.33e-5</iyy><izz>5.33e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction><contact><ode><kp>1e6</kp><kd>1</kd><min_depth>0.001</min_depth></ode></contact></surface></collision>
        <visual name="v"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient></material></visual>
      </link>
    </model>

    <model name="target">
      <static>true</static>
      <pose>0.5 0.2 0.401 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 0.06 0.002</size></box></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient></material></visual>
      </link>
    </model>
  </world>
</sdf>
