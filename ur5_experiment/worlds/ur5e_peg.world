<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="ur5e_experiment">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>100</update_rate>
    </plugin>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
    <ode><solver><type>quick</type><iters>150</iters></solver></ode></physics>

    <model name="table">
      <static>true</static>
      <pose>0.55 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.8 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.8 0.4</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient></material></visual>
      </link>
    </model>

    

    
  
    <model name="fixture">
      <pose>0.5 0.2 0.42 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity><kinematic>true</kinematic>
        <inertial><mass>1</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="wall_px"><pose>0.020999999999999998 0 0 0 0 0</pose><geometry><box><size>0.016 0.057999999999999996 0.04</size></box></geometry><surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction><contact><ode><kp>1e6</kp><kd>1</kd><min_depth>0</min_depth></ode></contact></surface></collision><visual name="wall_px_v"><pose>0.020999999999999998 0 0 0 0 0</pose><geometry><box><size>0.016 0.057999999999999996 0.04</size></box></geometry><material><ambient>0.3 0.3 0.8 1</ambient></material></visual>
        <collision name="wall_nx"><pose>-0.020999999999999998 0 0 0 0 0</pose><geometry><box><size>0.016 0.057999999999999996 0.04</size></box></geometry><surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction><contact><ode><kp>1e6</kp><kd>1</kd><min_depth>0</min_depth></ode></contact></surface></collision><visual name="wall_nx_v"><pose>-0.020999999999999998 0 0 0 0 0</pose><geometry><box><size>0.016 0.057999999999999996 0.04</size></box></geometry><material><ambient>0.3 0.3 0.8 1</ambient></material></visual>
        <collision name="wall_py"><pose>0 0.020999999999999998 0 0 0 0</pose><geometry><box><size>0.026 0.016 0.04</size></box></geometry><surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction><contact><ode><kp>1e6</kp><kd>1</kd><min_depth>0</min_depth></ode></contact></surface></collision><visual name="wall_py_v"><pose>0 0.020999999999999998 0 0 0 0</pose><geometry><box><size>0.026 0.016 0.04</size></box></geometry><material><ambient>0.3 0.3 0.8 1</ambient></material></visual>
        <collision name="wall_ny"><pose>0 -0.020999999999999998 0 0 0 0</pose><geometry><box><size>0.026 0.016 0.04</size></box></geometry><surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction><contact><ode><kp>1e6</kp><kd>1</kd><min_depth>0</min_depth></ode></contact></surface></collision><visual name="wall_ny_v"><pose>0 -0.020999999999999998 0 0 0 0</pose><geometry><box><size>0.026 0.016 0.04</size></box></geometry><material><ambient>0.3 0.3 0.8 1</ambient></material></visual>
      </link>
    </model>
  </world>
</sdf>
